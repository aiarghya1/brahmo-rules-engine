# ---------------------------------------------------------------------------
# Supabase. Leave these unset (or as-is) and the backend parses
# supabase/seed.sql into memory instead — the demo runs with no credentials.
# ---------------------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------------
# Optional policy switches
# ---------------------------------------------------------------------------
# Check 3 relaxation: treat own-department levels on the traversal path as
# inherited authority, so a ward nurse also reads her department's protocols.
# Default 0 (strict ceiling). See docs/architecture.md, "Check 3".
PERMISSION_INHERIT_DEPT_PATH=0
